# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: restrict to specific Telegram user IDs (comma-separated). Empty = allow all.
ALLOWED_USER_IDS=123456789,987654321

# Optional: dirs (default: ./output_dir and ./work_dir)
AEBN_OUTPUT_DIR=./output_dir
AEBN_WORK_DIR=./work_dir

# Optional: proxy for AEBN (same format as CLI -p)
AEBN_PROXY=
# socks5://user:pass@ip:port
# http://ip:port

# Optional: threads and concurrency
AEBN_THREADS=5
MAX_CONCURRENT_DOWNLOADS=2

# Telegram upload limit in MB (50 for hosted Bot API, up to 2000 for self-hosted Bot API server)
MAX_TELEGRAM_FILESIZE_MB=50

# AdultDVDEmpire cookies (for VOD content - paste full Netscape cookie file contents)
# Get from browser DevTools > Application > Cookies, or use Cookie-Editor extension
# Required for full VOD manifests (previews work without this)
ADE_COOKIES=

# Or: URL to fetch Netscape cookies from (auto-loaded on startup)
# Set this to the Thpaste raw_url for the ADE paste, if you use one.
ADE_COOKIES_URL=

# Thpaste two-way sync for the web UI cookies page (one paste per site).
# Create an API key at https://thpaste.com (Dashboard → API keys) and keep
# it server-side. Pasting cookies in the UI auto-pushes to these pastes.
THPASTE_API_KEY=
# Optional: reuse existing pastes instead of auto-creating one per site.
# THPASTE_ADE_ID=
# THPASTE_EA_ID=
# THPASTE_DVD_ID=
# Optional: stable custom links (https://thpaste.com/s/<slug>).
# THPASTE_ADE_SLUG=
# THPASTE_EA_SLUG=
# THPASTE_DVD_SLUG=
# Optional paste settings (defaults shown).
# THPASTE_VISIBILITY=unlisted
# THPASTE_EXPIRY=never

# Optional: lock the web UI behind a password
WEB_PASSWORD=
